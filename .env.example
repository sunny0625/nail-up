# Nail Up — environment variable template
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is git-ignored.
# NEVER commit real secrets or credentials. This file holds placeholders only.
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Everything else is server-only and must never be imported into a Client Component.

# --- Public (safe for the browser) ---------------------------------------------

# Supabase project URL, from Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key, from the same page. Protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL, used for metadata, sitemap and absolute links.
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# --- Server-only (never expose to the client) ----------------------------------

# Supabase service-role key. Bypasses Row Level Security. Server-side use only.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key for transactional email. Server-side use only.
RESEND_API_KEY=

# Sender address used for outgoing email (must be a verified Resend sender).
EMAIL_FROM=

# Address that receives booking and contact notifications for the studio.
EMAIL_BUSINESS_NOTIFICATION=
